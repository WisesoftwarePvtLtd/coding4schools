<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Embedded Python Editor</title>

    <!-- Pyodide -->
    <script src="https://cdn.jsdelivr.net/pyodide/v0.25.1/full/pyodide.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            padding: 20px;
        }

        h2 {
            text-align: center;
        }

        .editor-container {
            max-width: 900px;
            margin: auto;
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        textarea {
            width: 100%;
            height: 250px;
            font-family: monospace;
            font-size: 15px;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .btn-group {
            margin-top: 10px;
            display: flex;
            gap: 10px;
        }

        button {
            padding: 10px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .run { background: #28a745; color: #fff; }
        .save { background: #007bff; color: #fff; }
        .load { background: #6c757d; color: #fff; }

        pre {
            background: #000;
            color: #0f0;
            padding: 12px;
            margin-top: 15px;
            height: 200px;
            overflow-y: auto;
            border-radius: 6px;
        }
    </style>
</head>

<body>

<h2>🧠 Embedded Python Editor</h2>

<div class="editor-container">
    <textarea id="code">
print("Hello, Python!")
for i in range(5):
    print(i)
    </textarea>

    <div class="btn-group">
        <button class="run" onclick="runCode()">▶ Run</button>
        <button class="save" onclick="saveCode()">💾 Save</button>
        <button class="load" onclick="loadCode()">📂 Load</button>
    </div>

    <pre id="output">Output will appear here...</pre>
</div>

<script>
    let pyodideReady = false;
    let pyodide;

    async function loadPyodideAndPackages() {
        pyodide = await loadPyodide();
        pyodideReady = true;
    }

    loadPyodideAndPackages();

    async function runCode() {
        if (!pyodideReady) {
            document.getElementById("output").textContent = "Loading Python...";
            return;
        }

        const code = document.getElementById("code").value;
        const outputEl = document.getElementById("output");

        try {
            pyodide.runPython(`
import sys
from io import StringIO
sys.stdout = StringIO()
            `);

            pyodide.runPython(code);

            const output = pyodide.runPython("sys.stdout.getvalue()");
            outputEl.textContent = output || "✔ Code executed successfully.";
        } catch (err) {
            outputEl.textContent = err;
        }
    }

    function saveCode() {
        const code = document.getElementById("code").value;
        localStorage.setItem("python_code", code);
        alert("Code saved successfully!");
    }

    function loadCode() {
        const saved = localStorage.getItem("python_code");
        if (saved) {
            document.getElementById("code").value = saved;
        } else {
            alert("No saved code found!");
        }
    }
</script>

</body>
</html>
