        // Detect keyboard shortcuts for screenshots
        document.addEventListener('keydown', function(e) {
            console.log('Key:', e.key, 'Meta:', e.metaKey, 'Shift:', e.shiftKey, 'Ctrl:', e.ctrlKey);
            
